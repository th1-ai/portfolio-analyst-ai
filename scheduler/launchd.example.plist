<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Scheduling portfolio-analyst-ai's morning digest on a Mac.

  launchd is better than cron on a laptop: it catches up after the machine
  wakes instead of silently skipping the run. This agent has exactly one
  recurring job (config/agent.yaml: schedule.digest) - there is no "main
  loop" to poll; asking a question is always on demand (workflows/10-ask.md).

  1. Replace /path/to/portfolio-analyst-ai below with the output of `pwd`
     in this folder.
  2. Save as ~/Library/LaunchAgents/ai.th1.portfolio-analyst-ai-digest.plist
  3. launchctl load ~/Library/LaunchAgents/ai.th1.portfolio-analyst-ai-digest.plist
  4. launchctl list | grep portfolio-analyst-ai-digest
  To stop:  launchctl unload ~/Library/LaunchAgents/ai.th1.portfolio-analyst-ai-digest.plist

  tools/schedule.py, run with its "all jobs" and "launchd" options (see
  workflows/16-digest.md), prints this with your own machine's real paths
  already filled in - prefer that over hand-editing.
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>ai.th1.portfolio-analyst-ai-digest</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/sh</string>
      <string>-c</string>
      <string>cd /path/to/portfolio-analyst-ai &amp;&amp; /path/to/portfolio-analyst-ai/.venv/bin/python tools/run.py --once --digest</string>
    </array>

    <!-- 07:00 daily - config/agent.yaml: schedule.digest.cadence: "morning". -->
    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>7</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/path/to/portfolio-analyst-ai</string>

    <key>StandardOutPath</key>
    <string>/path/to/portfolio-analyst-ai/data/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/portfolio-analyst-ai/data/logs/launchd.err</string>

    <!-- Do not fire immediately on load: run it by hand first. -->
    <key>RunAtLoad</key>
    <false/>
  </dict>
</plist>
